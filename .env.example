# =============================================================================
# Biến môi trường cho frontend (Vite). Sao chép thành .env.local khi chạy local.
# Trên Cloudflare Pages: Settings → Environment variables (xem docs/setup-cloudflare.md)
# Chỉ các biến có tiền tố VITE_ được đưa vào trình duyệt – KHÔNG đặt secret ở đây.
# =============================================================================
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>
# Domain Google Workspace (tham số hd khi đăng nhập), ví dụ mitafood.vn
VITE_GOOGLE_HD=[DOMAIN]

# =============================================================================
# Supabase CLI local (supabase start) – đọc bởi supabase/config.toml
# =============================================================================
SUPABASE_AUTH_GOOGLE_CLIENT_ID=<google oauth client id>
SUPABASE_AUTH_GOOGLE_SECRET=<google oauth client secret>

# =============================================================================
# Secrets của Edge Functions – đặt bằng `supabase secrets set` (KHÔNG commit)
# Dùng từ M1 (email) và M3/M4 (Drive). Xem docs/setup-supabase.md
# =============================================================================
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# GOOGLE_SYSTEM_USER=[SYSTEM_USER]@[DOMAIN]
# APP_ORIGIN=https://work.[DOMAIN]
# CRON_SECRET=<chuỗi ngẫu nhiên dài, dùng cho pg_cron gọi cron-runner>

# =============================================================================
# GitHub Actions secrets (Settings → Secrets and variables → Actions) – M6 backup
# =============================================================================
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# GOOGLE_SERVICE_ACCOUNT_JSON=...
# GOOGLE_SYSTEM_USER=...
# BACKUP_DRIVE_FOLDER_ID=...
